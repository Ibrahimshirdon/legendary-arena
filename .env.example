VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET is in Firebase's config snippet but unused here —
# this app has no file storage service; avatars are stored as data URLs in Postgres.

# The Express API server (see server/) — defaults to this if unset.
VITE_API_URL=http://localhost:8787
