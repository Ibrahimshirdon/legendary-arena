# Neon connection string (from the Neon console: Dashboard → Connect)
DATABASE_URL=

# Port the API server listens on
PORT=8787

# Firebase Admin credentials, used only to verify ID tokens sent by the frontend.
# From Firebase console: Project settings → Service accounts → Generate new private key.
# Paste the downloaded JSON file's contents here as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated list of origins allowed to call this API (your Vite dev server, your deployed frontend).
CORS_ORIGIN=http://localhost:5173
